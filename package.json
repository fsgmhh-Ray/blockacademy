{
  "name": "blockacademy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "方块学院 BlockAcademy —— 体素沙盒 × AI NPC 小学科学探索游戏",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --external:three --outfile=.tmp-smoke.mjs --log-level=warning && node .tmp-smoke.mjs"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wrangler": "^3.114.17"
  }
}
